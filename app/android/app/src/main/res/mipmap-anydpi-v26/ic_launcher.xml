<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive icon (Android 8+). The launcher masks the layers to whatever
     shape the device uses, so the foreground art is inset rather than
     bleeding to the edges. Android 12+ also renders this foreground in the
     system splash screen shown while the app starts. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>

# ── Flutter / Dart ────────────────────────────────────────────────────────
app/.dart_tool/
app/.flutter-plugins
app/.flutter-plugins-dependencies
app/build/
app/.packages
app/**/generated_plugin_registrant.*
app/**/GeneratedPluginRegistrant.*
.pub-cache/
.pub/
*.iml

# ── Secrets: never commit ────────────────────────────────────────────────
# Signing keys. Losing these strands every existing install; leaking them
# lets anyone ship a "Felicek update" your users' phones will accept.
app/android/key.properties
*.jks
*.keystore
*.p12
*.pem
# Written by scripts/make_keystore.sh: contains the keystore password and the
# whole key base64-encoded, ready to paste into GitHub secrets.
keystore-secrets.txt

# Per-project Firebase config.
#
# app/android/app/google-services.json IS committed, on purpose. It contains no
# secret: a Firebase Android "API key" identifies the project, it does not
# authorise anything, and it ships inside every APK — so anyone who downloads a
# build already has it. Google documents these as safe to check in.
#
# What actually protects this project is firebase/firestore.rules (and the 61
# tests pinning it). Do not treat this file as a security boundary; if it ever
# needs restricting, do it in Google Cloud Console → Credentials → API key
# restrictions, not by hiding the file.
#
# Apple's GoogleService-Info.plist stays ignored simply because no iOS/macOS
# app has been registered in the project yet.
app/ios/Runner/GoogleService-Info.plist
app/macos/Runner/GoogleService-Info.plist
firebase/.firebaserc
.firebase/

